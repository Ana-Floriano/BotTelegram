import os
import time
from dotenv import load_dotenv
import requests

load_dotenv(".env")
TOKEN = os.getenv("TELEGRAM_TOKEN")
BASE_URL = f"https://api.telegram.org/bot{TOKEN}"

user_news_state = {}
GNEWS_URL = "https://gnews.io/api/v4/search?q=brasil&lang=pt&country=br&max=5&apikey=c88d9a4db1aca47c10886ed1c7a67032"

def send_message(chat_id, text):
  return requests.post(f"{BASE_URL}/sendMessage", data={"chat_id": chat_id, "text": text, "parse_mode": "HTML"},).json()

def send_next_news(chat_id):
  state = user_news_state[chat_id]
  articles = state["articles"]
  index = state["index"]

  if index >= len(articles):
    send_message(chat_id, "Fim das noticias!\n\nUse /noticias para iniciar outra ronda.")
    del user_news_state[chat_id]
    return

  art = articles[index]
  msg = (f"Noticia {index + 1} de {len(articles)}\n\n"f"{art.get('title')}\n\n"
      f"Ler mais: {art.get('url')}\n\n"
      "<b>1.</b> Ver próxima notícia\n<b>0.</b> Encerrar\n\nResponda enviando 1 ou 0.")
  
  send_message(chat_id, msg)

def main():
  print("Bot de Noticias iniciado e a aguardar interações...")
  requests.get(f"{BASE_URL}/deleteWebhook")
  last_update_id = 0

  while True:
    res = requests.get(f"{BASE_URL}/getUpdates?offset={last_update_id + 1}&timeout=10")
    
    if res.status_code == 200:
      for update in res.json().get("result", []):
        last_update_id = update["update_id"]

        if "message" in update and "text" in update["message"]:
          chat_id = update["message"]["chat"]["id"]
          text = update["message"]["text"].strip()

          if text.lower() == "/start":
            send_message(chat_id, "Olá! Bem-vindo ao InfoBrasil_Bot.\n\nUse /noticias para"
                            " comecar a receber as manchetes do Brasil uma a uma.",)
            
          elif text.lower() == "/noticias":
            response = requests.get(GNEWS_URL)
            articles = (response.json().get("articles", [])
                
                if response.status_code == 200
                else [])

            if articles:
              user_news_state[chat_id] = {"articles": articles, "index": 0}
              send_message(chat_id, "A carregar a primeira notícia...")
              send_next_news(chat_id)
            
            else:
              send_message(chat_id, "Erro ao carregar notícias. Tente mais tarde.")

          elif chat_id in user_news_state:
            
            if text == "1":
              user_news_state[chat_id]["index"] += 1
              send_next_news(chat_id)
            
            elif text == "0":
              send_message(chat_id, "Sessão encerrada. Use /noticias quando quiser novamente!.")
              del user_news_state[chat_id]
            
            else:
              send_message(chat_id, "Opção inválida. Envie <b>1</b> ou <b>0</b>.")
          
          else:
            send_message(chat_id, "Comando desconhecido. Use /start ou /noticias.")

    time.sleep(0.5)

if __name__ == "__main__":
  main()
