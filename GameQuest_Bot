import html
import os
import random
import time
from dotenv import load_dotenv
import requests

load_dotenv(".env")
TOKEN = os.getenv("TELEGRAM_TOKEN")
BASE_URL = f"https://api.telegram.org/bot{TOKEN}"

user_games = {}

def get_game_questions():
    url = "https://opentdb.com/api.php?amount=5&category=16&difficulty=easy&type=multiple"
    response = requests.get(url)

    if response.status_code == 200:
        return response.json().get("results", [])

    return []

def send_message(chat_id, text):
  """Envia uma mensagem de texto para o chat do Telegram."""
  url = f"{BASE_URL}/sendMessage"
  data = {"chat_id": chat_id, "text": text, "parse_mode": "HTML"}
  response = requests.post(url, data=data)
  return response.json()

def send_question(chat_id):
    game = user_games[chat_id]
    index = game["index"]
    questions = game["questions"]

    if index >= len(questions):
        score = game["score"]
        total = len(questions)
        send_message(chat_id, f"Fim de Jogo!\n\nAcertaste {score} de"
            f" {total} perguntas.\n\nUsa /jogar para dares nova partida!",)

        del user_games[chat_id]  
        return

    q = questions[index]
    question_text = html.unescape(q["question"])
    correct_answer = html.unescape(q["correct_answer"])
    incorrect_answers = [html.unescape(ans) for ans in q["incorrect_answers"]]

    all_options = incorrect_answers + [correct_answer]
    random.shuffle(all_options)

    game["current_options"] = all_options
    game["correct_answer"] = correct_answer

    options_text = ""
    for i, opt in enumerate(all_options, 1):
        options_text += f"<b>{i}.</b> {opt}\n"

    msg = (f"Questão {index + 1} / {len(questions)}\n\n{question_text}\n\n"
        f"{options_text}\nResponde enviando apenas o número da tua opção (1, 2, 3 ou 4).")
    send_message(chat_id, msg)   

def main():
    print("Bot de Quiz (Jogos de Tabuleiro) iniciado e a aguardar interações...")

    requests.get(f"{BASE_URL}/deleteWebhook")
    last_update_id = 0

    while True:
        updates_url = f"{BASE_URL}/getUpdates?offset={last_update_id + 1}&timeout=10"
        response = requests.get(updates_url)

        if response.status_code == 200:
            data = response.json()
            updates = data.get("result", [])

            for update in updates:
                last_update_id = update["update_id"]

                if "message" in update and "text" in update["message"]:
                    chat_id = update["message"]["chat"]["id"]
                    text = update["message"]["text"].strip()
                    text_lower = text.lower()

                    if text_lower == "/start":
                        send_message(chat_id, "Olá! Bem-vindo ao QuizBot de Jogos de"
                            " Tabuleiro!\n\nIntegrado com a Open Trivia"
                            " DB.\n\nUsa /jogar para iniciar o desafio!",) 

                    elif text_lower == "/jogar":
                        questions = get_game_questions()

                        if questions:
                            user_games[chat_id] = {
                                "questions": questions,
                                "index": 0,
                                "score": 0,
                                "current_options": [],
                                "correct_answer": "",
                            }

                            send_message(chat_id, "Jogo iniciado! Boa sorte!")
                            send_question(chat_id)

                        else:
                            send_message(chat_id, "Erro ao ligar à API de perguntas. Tenta novamente mais tarde.",)
                        
                    elif chat_id in user_games:
                        game = user_games[chat_id]

                        if text.isdigit():
                            choice_idx = int(text) - 1
                            options = game["current_options"]

                            if 0 <= choice_idx < len(options):
                                chosen_answer = options[choice_idx]
                                correct_answer = game["correct_answer"]

                                if chosen_answer == correct_answer:
                                    game["score"] += 1
                                    send_message(chat_id, "Correto!")
                                else:
                                    send_message(chat_id, "Incorreto! A resposta certa era:"
                                        f" <b>{correct_answer}</b>",)

                                game["index"] += 1
                                send_question(chat_id)

                            else:
                                send_message(chat_id, "Opção inválida. Escolhe um número entre 1 e"
                                    f" {len(options)}.",)

                        else:
                            send_message(chat_id, "Por favor, envia apenas o número correspondente à"
                                " tua resposta (ex: 1, 2, 3 ou 4).",)

                    else:
                        send_message(chat_id,"Comando não reconhecido. Usa /start para ver as instruções ou"
                            " /jogar para começar.",)

        time.sleep(0.5)

if __name__ == "__main__":
    main() 
